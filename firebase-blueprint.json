        "nama": { "type": "string", "description": "Full name of the user" },
        "role": { "type": "string", "description": "Role permission: admin_rw, sekretaris, bendahara, ketua_rt, keamanan, pengurus_rkm, warga" },
        "roleLabel": { "type": "string", "description": "Human readable label of role" },
        "rtAccess": { "type": "string", "description": "ALL or RT number e.g. 039" },
        "noHp": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "isActive": { "type": "boolean", "description": "Active status" },
        "description": { "type": "string", "description": "Short description" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last login" }
      },
      "required": ["id", "username", "nama", "role", "isActive"]
