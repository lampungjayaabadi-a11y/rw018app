rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Production baseline: never expose Firestore without Firebase Authentication.
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isPrivileged() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw']);
    }

    function canManageAdministration() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'sekretaris']);
    }

    function canManageFinance() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'bendahara']);
    }

    function canManageSecurity() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'keamanan']);
    }

    function canManageRkm() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'pengurus_rkm', 'pengurus_dkm']);
    }

    function canReadGeneral() {
      return activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'sekretaris', 'bendahara', 'ketua_rt', 'keamanan', 'pengurus_rkm', 'pengurus_dkm']);
    }

    function canReadResident() {
      return activeUser() && userRole() == 'warga';
    }

    // Never store passwords in Firestore. Client may create/update only its own profile,
    // while privileged users may manage other user profiles.
    function validUserWrite(userId) {
      return isValidId(userId) && isValidUser(request.resource.data)
        && !('password' in request.resource.data)
        && request.resource.data.id == userId;
    }

    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 256; }
    function isRequiredString(val, minLen, maxLen) { return val is string && val.size() >= minLen && val.size() <= maxLen; }
    function isRequiredNumber(val, minVal, maxVal) { return val is number && val >= minVal && val <= maxVal; }
    function isSafeString(val, minLen, maxLen) { return val == null || (val is string && val.size() >= minLen && val.size() <= maxLen); }
    function isSafeNumber(val, minVal, maxVal) { return val == null || (val is number && val >= minVal && val <= maxVal); }

    // --- Entity Validators ---

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'nama', 'role', 'isActive'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.username, 1, 64)
        && isSafeString(data.nama, 1, 128)
        && isSafeString(data.role, 1, 64)
        && data.isActive is bool
        && (!('noHp' in data) || data.noHp == null || data.noHp is string)
        && (!('rtAccess' in data) || data.rtAccess == null || data.rtAccess is string);
    }

    function isValidProfile(data) {
      return (!('namaRw' in data) || isSafeString(data.namaRw, 0, 128))
        && (!('kelurahan' in data) || isSafeString(data.kelurahan, 0, 128))
        && (!('kecamatan' in data) || isSafeString(data.kecamatan, 0, 128))
        && (!('kotaKab' in data) || isSafeString(data.kotaKab, 0, 128))
        && (!('id' in data) || isSafeString(data.id, 1, 128))
        && (!('nomorRw' in data) || isSafeString(data.nomorRw, 0, 32));
    }

    function isValidWarga(data) {
      return data.keys().hasAll(['id', 'nik', 'noKk', 'nama', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.nik, 1, 64)
        && isSafeString(data.noKk, 1, 64)
        && isSafeString(data.nama, 1, 128)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidKK(data) {
      return data.keys().hasAll(['id', 'noKk', 'kepalaKeluarga', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.noKk, 1, 64)
        && isSafeString(data.kepalaKeluarga, 1, 128)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidKas(data) {
      return (!('id' in data) || isSafeString(data.id, 1, 128))
        && (!('tanggal' in data) || isSafeString(data.tanggal, 0, 64))
        && (!('kategori' in data) || isSafeString(data.kategori, 0, 128))
        && (!('jumlah' in data) || data.jumlah is number)
        && (!('jenis' in data) || isSafeString(data.jenis, 0, 64))
        && (!('tipe' in data) || isSafeString(data.tipe, 0, 64))
        && (!('keterangan' in data) || isSafeString(data.keterangan, 0, 8192));
    }

    function isValidIuran(data) {
      return data.keys().hasAll(['id', 'namaKepala', 'rt', 'bulanTahun', 'nominal', 'status'])
        && isSafeString(data.id, 1, 128)
        && (!('noKk' in data) || isSafeString(data.noKk, 0, 64))
        && isSafeString(data.namaKepala, 1, 128)
        && isSafeString(data.rt, 1, 32)
        && isSafeString(data.bulanTahun, 1, 64)
        && isSafeNumber(data.nominal, 0, 1000000000)
        && isSafeString(data.status, 1, 64);
    }

    function isValidSurat(data) {
      return data.keys().hasAll(['id', 'jenisSurat', 'nikPemohon', 'namaPemohon', 'rt', 'status'])
        && isSafeString(data.id, 1, 128)
        && (!('noSurat' in data) || isSafeString(data.noSurat, 0, 128))
        && (!('nomorSurat' in data) || isSafeString(data.nomorSurat, 0, 128))
        && isSafeString(data.jenisSurat, 1, 128)
        && isSafeString(data.nikPemohon, 1, 64)
        && isSafeString(data.namaPemohon, 1, 128)
        && isSafeString(data.rt, 1, 32)
        && isSafeString(data.status, 1, 64);
    }

    function isValidIuranRKM(data) {
      return isRequiredString(data.id, 1, 128)
        && isSafeString(data.namaKepala, 0, 128)
        && isSafeString(data.namaWarga, 0, 128)
        && (!('nik' in data) || isSafeString(data.nik, 0, 64))
        && (!('noKk' in data) || isSafeString(data.noKk, 0, 64))
        && (!('rt' in data) || isSafeString(data.rt, 0, 32))
        && (!('bulanTahun' in data) || isSafeString(data.bulanTahun, 0, 128))
        && (!('nominal' in data) || isSafeNumber(data.nominal, 0, 1000000000))
        && (!('status' in data) || isSafeString(data.status, 0, 64));
    }

    function isValidWargaMeninggal(data) {
      return data.keys().hasAll(['id', 'nama', 'rt', 'tanggalMeninggal'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.nama, 1, 128)
        && isSafeString(data.rt, 1, 32)
        && isSafeString(data.tanggalMeninggal, 1, 64)
        && (!('santunanRkm' in data) || isSafeNumber(data.santunanRkm, 0, 10000000000));
    }

    function isValidPerlengkapanRKM(data) {
      return data.keys().hasAll(['id', 'namaBarang', 'kategori', 'jumlah', 'status'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.namaBarang, 1, 128)
        && isSafeString(data.kategori, 0, 64)
        && isSafeNumber(data.jumlah, 0, 10000000)
        && isSafeString(data.status, 0, 64);
    }

    function isValidKeamanan(data) {
      return data.keys().hasAll(['id', 'namaProgram', 'kategori', 'anggaran', 'status'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.namaProgram, 1, 128)
        && isSafeString(data.kategori, 0, 64)
        && isSafeNumber(data.anggaran, 0, 100000000000)
        && isSafeString(data.status, 0, 64);
    }

    function isValidBansos(data) {
      return data.keys().hasAll(['id', 'nik', 'rt', 'jenisBansos'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.nik, 1, 64)
        && (!('nama' in data) || isSafeString(data.nama, 0, 128))
        && (!('namaPenerima' in data) || isSafeString(data.namaPenerima, 0, 128))
        && isSafeString(data.rt, 1, 32)
        && isSafeString(data.jenisBansos, 1, 64)
        && (!('status' in data) || isSafeString(data.status, 0, 64))
        && (!('statusPenyaluran' in data) || isSafeString(data.statusPenyaluran, 0, 64));
    }

    function isValidCadanganBansos(data) {
      return data.keys().hasAll(['id', 'nik', 'nama', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.nik, 1, 64)
        && isSafeString(data.nama, 1, 128)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidUmkm(data) {
      return data.keys().hasAll(['id', 'namaUsaha', 'kategori', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.namaUsaha, 1, 128)
        && (!('namaPemilik' in data) || isSafeString(data.namaPemilik, 0, 128))
        && (!('pemilik' in data) || isSafeString(data.pemilik, 0, 128))
        && isSafeString(data.kategori, 0, 64)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidKegiatan(data) {
      return data.keys().hasAll(['id', 'judul', 'kategori', 'tanggal', 'lokasi'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.judul, 1, 256)
        && isSafeString(data.kategori, 0, 64)
        && isSafeString(data.tanggal, 1, 64)
        && isSafeString(data.lokasi, 0, 256);
    }

    function isValidPengaduan(data) {
      return (!('id' in data) || isSafeString(data.id, 1, 128))
        && (!('namaPelapor' in data) || isSafeString(data.namaPelapor, 0, 128))
        && (!('namaWarga' in data) || isSafeString(data.namaWarga, 0, 128))
        && (!('nikPelapor' in data) || isSafeString(data.nikPelapor, 0, 64))
        && (!('nikWarga' in data) || isSafeString(data.nikWarga, 0, 64))
        && (!('rt' in data) || isSafeString(data.rt, 0, 32))
        && (!('kategori' in data) || isSafeString(data.kategori, 0, 128))
        && (!('judul' in data) || isSafeString(data.judul, 0, 512))
        && (!('deskripsi' in data) || isSafeString(data.deskripsi, 0, 50000))
        && (!('isi' in data) || isSafeString(data.isi, 0, 50000))
        && (!('isiPengaduan' in data) || isSafeString(data.isiPengaduan, 0, 50000))
        && (!('lokasiSpesifik' in data) || isSafeString(data.lokasiSpesifik, 0, 512))
        && (!('lokasiKejadian' in data) || isSafeString(data.lokasiKejadian, 0, 512))
        && (!('tanggalLapor' in data) || isSafeString(data.tanggalLapor, 0, 64))
        && (!('tanggal' in data) || isSafeString(data.tanggal, 0, 64))
        && (!('status' in data) || isSafeString(data.status, 0, 64))
        && (!('prioritas' in data) || isSafeString(data.prioritas, 0, 64))
        && (!('tanggapan' in data) || isSafeString(data.tanggapan, 0, 10000))
        && (!('tanggapanRw' in data) || isSafeString(data.tanggapanRw, 0, 10000))
        && (!('tindakLanjut' in data) || isSafeString(data.tindakLanjut, 0, 10000));
    }

    function isValidPBB(data) {
      return data.keys().hasAll(['id', 'nop', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.nop, 1, 64)
        && (!('namaWp' in data) || isSafeString(data.namaWp, 0, 128))
        && (!('namaWajibPajak' in data) || isSafeString(data.namaWajibPajak, 0, 128))
        && isSafeString(data.rt, 1, 32)
        && (!('tagihan' in data) || isSafeNumber(data.tagihan, 0, 10000000000))
        && (!('totalTagihan' in data) || isSafeNumber(data.totalTagihan, 0, 10000000000))
        && (!('statusBayar' in data) || isSafeString(data.statusBayar, 0, 64))
        && (!('statusPembayaran' in data) || isSafeString(data.statusPembayaran, 0, 64));
    }

    function isValidJadwalRonda(data) {
      return data.keys().hasAll(['id', 'hari', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.hari, 1, 64)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidAbsensiRonda(data) {
      return data.keys().hasAll(['id', 'tanggal', 'hari', 'rt'])
        && isSafeString(data.id, 1, 128)
        && isSafeString(data.tanggal, 1, 64)
        && isSafeString(data.hari, 1, 64)
        && isSafeString(data.rt, 1, 32);
    }

    function isValidSettings(data) {
      return (!('id' in data) || isSafeString(data.id, 1, 128));
    }

    function isValidLaporanKejadian(data) {
      return (!('id' in data) || isSafeString(data.id, 1, 128))
        && (!('nomorLaporan' in data) || isSafeString(data.nomorLaporan, 0, 128))
        && (!('jenisKejadian' in data) || isSafeString(data.jenisKejadian, 0, 128))
        && (!('tanggalKejadian' in data) || isSafeString(data.tanggalKejadian, 0, 64))
        && (!('waktuKejadian' in data) || isSafeString(data.waktuKejadian, 0, 64))
        && (!('lokasiKejadian' in data) || isSafeString(data.lokasiKejadian, 0, 512))
        && (!('rt' in data) || isSafeString(data.rt, 0, 32))
        && (!('rw' in data) || isSafeString(data.rw, 0, 32))
        && (!('kronologi' in data) || isSafeString(data.kronologi, 0, 50000));
    }

    // =========================================================================
    // COLLECTION RULES (Granular Operations & Structural Integrity)
    // =========================================================================

    // Users Collection

    match /test/{docId} {
      allow get: if false; // connection probes must not leak database access
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if activeUser() && (request.auth.uid == userId || isPrivileged());
      allow list: if isPrivileged();
      allow create: if activeUser() && request.auth.uid == userId && validUserWrite(userId);
      allow update: if activeUser() && (request.auth.uid == userId || isPrivileged())
                    && validUserWrite(userId)
                    && (request.auth.uid != userId || request.resource.data.role == resource.data.role);
      allow delete: if isPrivileged() && userId != request.auth.uid;
    }

    match /profile/{profileId} {
      allow read: if activeUser();
      allow create, update: if canManageAdministration() && isValidId(profileId) && isValidProfile(request.resource.data);
      allow delete: if false;
    }

    // Resident/civil data: authenticated staff can read; only authorized administration can write.
    match /warga/{wargaId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageAdministration() && isValidId(wargaId) && isValidWarga(request.resource.data);
    }
    match /kk/{kkId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageAdministration() && isValidId(kkId) && isValidKK(request.resource.data);
    }

    match /surat/{suratId} {
      allow read: if activeUser();
      allow create, update: if activeUser() && (canManageAdministration() || userRole() == 'warga') && isValidId(suratId) && isValidSurat(request.resource.data);
      allow delete: if canManageAdministration() && isValidId(suratId);
    }

    match /pengaduan/{pengaduanId} {
      allow read: if activeUser();
      allow create: if activeUser() && isValidId(pengaduanId) && isValidPengaduan(request.resource.data);
      allow update, delete: if canManageAdministration() && isValidId(pengaduanId) && isValidPengaduan(request.resource.data);
    }

    match /kas/{kasId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageFinance() && isValidId(kasId) && isValidKas(request.resource.data);
    }
    match /iuran/{iuranId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageFinance() && isValidId(iuranId) && isValidIuran(request.resource.data);
    }
    match /pbb/{pbbId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageFinance() && isValidId(pbbId) && isValidPBB(request.resource.data);
    }
    match /bansos/{bansosId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageFinance() && isValidId(bansosId) && isValidBansos(request.resource.data);
    }
    match /cadangan_bansos/{cadanganId} {
      allow read: if canReadGeneral();
      allow create, update, delete: if canManageFinance() && isValidId(cadanganId) && isValidCadanganBansos(request.resource.data);
    }

    match /iuran_rkm/{rkmId} {
      allow read: if canReadGeneral() || canManageRkm();
      allow create, update, delete: if canManageRkm() && isValidId(rkmId) && isValidIuranRKM(request.resource.data);
    }
    match /warga_meninggal/{meninggalId} {
      allow read: if canReadGeneral() || canManageRkm();
      allow create, update, delete: if canManageRkm() && isValidId(meninggalId) && isValidWargaMeninggal(request.resource.data);
    }
    match /perlengkapan_rkm/{itemId} {
      allow read: if canReadGeneral() || canManageRkm();
      allow create, update, delete: if canManageRkm() && isValidId(itemId) && isValidPerlengkapanRKM(request.resource.data);
    }

    match /keamanan/{progId} {
      allow read: if activeUser();
      allow create, update, delete: if canManageSecurity() && isValidId(progId) && isValidKeamanan(request.resource.data);
    }
    match /jadwal_ronda/{rondaId} {
      allow read: if activeUser();
      allow create, update, delete: if canManageSecurity() && isValidId(rondaId) && isValidJadwalRonda(request.resource.data);
    }
    match /absensi_ronda/{absensiId} {
      allow read: if activeUser();
      allow create, update, delete: if canManageSecurity() && isValidId(absensiId) && isValidAbsensiRonda(request.resource.data);
    }
    match /laporan_kejadian/{laporanId} {
      allow read: if activeUser() && (userRole() in ['super_admin', 'ketua_rw', 'admin_rw', 'keamanan']);
      allow create, update, delete: if canManageSecurity() && isValidId(laporanId) && isValidLaporanKejadian(request.resource.data);
    }

    match /umkm/{umkmId} {
      allow read: if activeUser();
      allow create, update, delete: if canManageAdministration() && isValidId(umkmId) && isValidUmkm(request.resource.data);
    }
    match /kegiatan/{kegiatanId} {
      allow read: if activeUser();
      allow create, update, delete: if canManageAdministration() && isValidId(kegiatanId) && isValidKegiatan(request.resource.data);
    }

    match /settings/{settingId} {
      allow get: if activeUser();
      allow list: if isPrivileged();
      allow create, update, delete: if isPrivileged() && isValidId(settingId) && isValidSettings(request.resource.data);
    }

    // Explicit deny-by-default for every unlisted collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
